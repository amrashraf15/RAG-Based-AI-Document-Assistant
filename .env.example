APP_NAME=RAG Document Assistant
APP_VERSION=0.1.0
OPENAI_API_KEY=your_real_key_here

MAX_PDF_SIZE_MB=50

UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
ALLOWED_FILE_EXTENSION=.pdf
CHUNK_SIZE=300
CHUNK_OVERLAP=50
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=
EMBEDDING_BATCH_SIZE=32
NORMALIZE_EMBEDDINGS=true
# Qdrant
QDRANT_COLLECTION_NAME=document_chunks
QDRANT_PATH=data/qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TIMEOUT=30
RERANKER_PROVIDER=sentence_transformers
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=
RERANKER_BATCH_SIZE=16
RERANKER_CANDIDATE_K=20
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b

LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=1000

RETRIEVAL_TOP_K=5
GENERATION_CONTEXT_MAX_CHARS=12000
REQUIRE_CITATIONS=true

API_TITLE=RAG Document Assistant API
API_DESCRIPTION=REST API for the RAG-Based AI Document Assistant
API_VERSION=1.0.0

API_HOST=
API_PORT=

API_MAX_SEARCH_RESULTS=20
API_MAX_CANDIDATE_RESULTS=50